# Data Folder (adjust to your installation path)
DATA_FOLDER=/path/to/decapod_servers/infrastructure

# The top level domain to serve from
DOMAIN_NAME=example.com

# Optional timezone to set which gets used by Cron-Node by default
# If not set New York time will be used
GENERIC_TIMEZONE=America/New_York

# The email address to use for the SSL certificate creation
SSL_EMAIL=your-email@example.com

# Streamer Configuration
# The base URL for n8n webhooks
N8N_BASE_URL=http://n8n:5678

# Neo4j Configuration
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme
NEO4J_IP=0.0.0.0

# Caddy Configuration
# IP address for Caddy to bind to (default: 0.0.0.0 for all interfaces)
# Set to a specific IP if you want to run multiple Caddy instances
CADDY_IP=0.0.0.0
