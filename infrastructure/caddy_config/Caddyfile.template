# Caddyfile template - Copy this to Caddyfile and edit with your domain names
# Configure DNS A records pointing to your server IP

n8n.example.com {
    reverse_proxy n8n:5678 {
        flush_interval -1
    }
}

owui.example.com {
    reverse_proxy openwebui:8080 {
        flush_interval -1
    }
}

s3.example.com {
    reverse_proxy minio:9000 {
        flush_interval -1
    }
}

console.s3.example.com {
    reverse_proxy minio:9001 {
        flush_interval -1
    }
}

noco.example.com {
    reverse_proxy nocodb:8080 {
        flush_interval -1
    }
}

age.example.com {
    reverse_proxy age-viewer:3000
}
