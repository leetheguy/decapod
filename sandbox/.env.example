# Sandbox SSH Container
# A sandboxed Ubuntu environment for agent access via SSH

# Agent SSH password - change this to a secure password
AGENT_PASSWORD=changeme

# Access from other containers on the 'web' network:
#   ssh agent@sandbox
#
# Connection details for n8n or other tools:
#   Host: sandbox
#   Port: 22
#   Username: agent
#   Password: (the value set above)
#
# The agent user has full sudo access without password.
# The container includes: Python 3, uv, Node.js (via nvm), Git, Vim, and more.
