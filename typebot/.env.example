# The top level domain (must match infrastructure/.env)
DOMAIN_NAME=example.com

# Postgres configuration (must match infrastructure/.env)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

# Typebot specific database name (will be created in Postgres)
TYPEBOT_POSTGRES_DB=typebot

# Encryption secret for sensitive data - generate with: openssl rand -hex 16
TYPEBOT_ENCRYPTION_SECRET=changeme

# Admin email (first signup with this email gets admin access)
TYPEBOT_ADMIN_EMAIL=admin@example.com
