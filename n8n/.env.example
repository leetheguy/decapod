# Domain Configuration
DOMAIN_NAME=example.com
SUBDOMAIN=n8n

# Data Folder (adjust to your installation path)
DATA_FOLDER=/path/to/decapod_servers/n8n

# n8n Configuration
GENERIC_TIMEZONE=America/New_York

# The email address to use for the SSL certificate creation
SSL_EMAIL=your-email@example.com

N8N_LICENSE_ACTIVATION_KEY=your_license_key_here  # Optional: for n8n Enterprise features

# Database Configuration (Postgres)
# These should match your infrastructure/.env settings
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

# Task Runners (must match infrastructure/.env)
N8N_RUNNERS_AUTH_TOKEN=changeme
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme
MINIO_SERVER_URL=https://s3.example.com
MINIO_BROWSER_REDIRECT_URL=https://console.s3.example.com
