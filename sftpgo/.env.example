# The top level domain (must match infrastructure/.env)
DOMAIN_NAME=example.com

# Postgres configuration (must match infrastructure/.env)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

# SFTPGo specific database name (will be created in Postgres)
SFTPGO_POSTGRES_DB=sftpgo

# SFTPGo admin credentials
SFTPGO_ADMIN_USER=admin
SFTPGO_ADMIN_PASSWORD=changeme
