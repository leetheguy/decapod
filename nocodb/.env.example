# The top level domain to serve from (must match infrastructure/.env)
DOMAIN_NAME=example.com

# Subdomain for NocoDB (e.g., "db" will result in db.example.com)
SUBDOMAIN=db

# Postgres Configuration (must match infrastructure/.env)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

# NocoDB specific database name (will be created in Postgres)
NOCODB_POSTGRES_DB=nocodb

# NocoDB Admin Credentials
NOCODB_ADMIN_EMAIL=admin@example.com
NOCODB_ADMIN_PASSWORD=changeme

# JWT Secret for NocoDB (generate a secure random string)
NOCODB_JWT_SECRET=your-secure-jwt-secret-min-32-characters-long
